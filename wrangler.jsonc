{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akram-portfolio",
  "compatibility_date": "2026-10-11",
  // Astro builds the finished site into dist/. Cloudflare serves it as static assets.
  "assets": {
    "directory": "./dist",
    // Serve src/pages/404.astro for unknown URLs.
    "not_found_handling": "404-page"
  }
}
