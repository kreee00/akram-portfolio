---
/* A home-page section: a mono "// LABEL" heading, then content.
   <Section label="Skills & toolbox" id="skills" note="Optional line"> ... </Section>
   Put a link on the right of the heading with <a slot="action" ...>. */
import { slugify } from "../lib/format.js";

interface Props {
  label: string;
  note?: string;
  id?: string;
}
const { label, note, id } = Astro.props;
const headingId = (id || slugify(label)) + "-h";
---
<section class="section" id={id} aria-labelledby={headingId}>
  <div class="section-head">
    <h2 id={headingId}>{label}</h2>
    <slot name="action" />
    {note && <p class="note">{note}</p>}
  </div>
  <slot />
</section>
