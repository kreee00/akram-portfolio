---
import Facts from "./Facts.astro";

interface Props {
  project: any;
  detailed?: boolean;
}
const { project: p, detailed = false } = Astro.props;
const href = detailed ? p.link : `projects.html#${p.id}`;
---
<li class:list={["project", { case: detailed }]} id={detailed ? p.id : undefined}>
  <div class="desc">
    <p class="kind">{p.kind}</p>
    <h3>{href ? <a href={href} rel={detailed ? "noopener" : undefined}>{p.title}</a> : p.title}</h3>
    <p>{p.summary}</p>
    {detailed && p.details?.length > 0 && (
      <dl>{p.details.map(([k, v]: [string, string]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
    )}
    {detailed && p.link && (
      <p><a class="more" href={p.link} rel="noopener">Visit {p.link.replace(/^https?:\/\//, "")} &rarr;</a></p>
    )}
  </div>
  <Facts items={p.facts} />
</li>
