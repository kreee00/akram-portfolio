---
/* Big title at the top of inner pages. Anything inside the tag
   becomes the intro paragraph. */
interface Props {
  label: string;
  title: string;
}
const { label, title } = Astro.props;
---
<header class="page-head">
  <p class="label">{label}</p>
  <h1>{title}</h1>
  {Astro.slots.has("default") && <p class="lede"><slot /></p>}
</header>
