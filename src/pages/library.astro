---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Bookshelf from "../sections/Bookshelf.astro";
import { blog } from "../data/site.js";
---
<Base title="Kutub Khanah" description="The bookshelf of Akram Faisal: books read and currently reading, with reviews on his blog.">
  <PageHead label="Kutub Khanah" title="The books on my shelf.">
    A running record of what I read, in English and Bahasa Melayu. When I write a review, it goes on <a href={blog.url} rel="noopener">my blog</a> and is linked here.
  </PageHead>
  <Bookshelf />
</Base>
