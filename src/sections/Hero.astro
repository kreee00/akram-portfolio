---
/* Home page hero with portrait.
   Photo: drop it in src/assets/headshot.jpg (portrait, about 800 x 1000 px).
   Until it exists, an "AF" monogram is shown. */
import { Image } from "astro:assets";

const found = import.meta.glob("../assets/headshot.{jpg,jpeg,png,webp}", { eager: true, import: "default" });
const photo: any = Object.values(found)[0];
---
<section class="hero" aria-labelledby="hero-name">
  <div class="hero-top">
    <div class="hero-title">
      <p class="label">Cybersecurity &middot; DevOps &middot; Governance, risk &amp; compliance</p>
      <h1 class="hero-name" id="hero-name"><span>Akram</span><span class="it">Faisal</span></h1>
    </div>
    <figure class:list={["portrait", { "no-photo": !photo }]}>
      {photo && <Image src={photo} alt="Portrait of Akram Faisal" width={560} widths={[320, 560]} sizes="(max-width: 640px) 15rem, 17rem" loading="eager" />}
      <span class="portrait-fallback" aria-hidden="true">AF</span>
      <figcaption class="label">Padang Rengas, Perak</figcaption>
    </figure>
  </div>
  <div class="hero-foot">
    <p class="lede">Final-year computer science student and part-time DevOps engineer, working toward security roles where technology meets policy.</p>
    <div class="hero-meta">
      <p class="status label">Open to graduate roles from Dec 2026</p>
      <p class="label">4.78&deg;N 100.86&deg;E</p>
    </div>
  </div>
</section>
