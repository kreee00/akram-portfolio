---
import Section from "../components/Section.astro";

const certs = [
  { name: "Memory Dump Analysis with Volatility3, Instructor", when: "Mar 2025", note: "CYBERHAX UTP" },
  { name: "CompTIA Security+", when: "Exam by Dec 2026", note: "Through the Yayasan Peneraju programme" },
  { name: "AWS Academy Cloud Foundations", when: "In progress", note: "Preparing for AWS Certified Cloud Practitioner" },
];
---
<Section label="Certifications">
  <ul class="facts-list">
    {certs.map((c) => (
      <li>
        <span class="what">{c.name}</span>
        <span class="label">{c.when}</span>
        {c.note && <span class="note">{c.note}</span>}
      </li>
    ))}
  </ul>
</Section>
