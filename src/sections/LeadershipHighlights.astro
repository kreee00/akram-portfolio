---
/* Home page: roles marked featured: true in src/data/leadership.js */
import Section from "../components/Section.astro";
import { leadership } from "../data/leadership.js";
const list = leadership.filter((l) => l.featured);
---
<Section label="Leadership" note="Youth councils, student government and civic work.">
  <ul class="lead-grid">
    {list.map((l) => (
      <li>
        <p class="when">{l.period}</p>
        <h3>{l.org}</h3>
        <p class="lead-role">{l.role}{l.note && <span class="muted"> &middot; {l.note}</span>}</p>
        <p class="muted">{l.summary}</p>
      </li>
    ))}
  </ul>
  <a class="more" href="experience.html#leadership">Details of each role &rarr;</a>
</Section>
