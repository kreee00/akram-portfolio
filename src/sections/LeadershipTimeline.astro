---
/* Experience page: every role in src/data/leadership.js */
import Section from "../components/Section.astro";
import { leadership } from "../data/leadership.js";
---
<Section label="Leadership & civic" id="leadership" note="Youth councils, student government and civic work.">
  <ol class="timeline">
    {leadership.map((l) => (
      <li>
        <p class="when">{l.period}</p>
        <div class="role">
          <h3>{l.role}</h3>
          <p class="org"><strong>{l.org}</strong>{l.note && <> &middot; {l.note}</>}</p>
          <p>{l.summary}</p>
          {l.points.length > 0 && <ul>{l.points.map((p) => <li>{p}</li>)}</ul>}
        </div>
      </li>
    ))}
  </ol>
</Section>
