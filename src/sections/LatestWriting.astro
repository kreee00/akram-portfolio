---
import Section from "../components/Section.astro";
import ArticleList from "../components/ArticleList.astro";
import { getArticles } from "../lib/articles.js";
import { blog } from "../data/site.js";

interface Props { limit?: number }
const { limit = 3 } = Astro.props;
const items = (await getArticles()).slice(0, limit);
---
<Section label="Latest writing" id="writing">
  <a slot="action" class="head-link" href={blog.archive} rel="noopener">All posts on {blog.name} &rarr;</a>
  <div class="panel">
    <ArticleList items={items} />
  </div>
</Section>
