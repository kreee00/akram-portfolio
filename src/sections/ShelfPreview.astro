---
/* Home page: a single card pointing to the full library page. */
import Section from "../components/Section.astro";
import BookCover from "../components/BookCover.astro";
import { books } from "../data/books.js";

const reading = books.find((b) => b.status === "reading");
const read = books.filter((b) => b.status === "read").length;
const next = books.filter((b) => b.status === "to-read").length;
---
<Section label="Kutub Khanah" id="library">
  <a slot="action" class="head-link" href="library.html">Full library ({books.length}) &rarr;</a>
  <div class="shelf-card panel">
    {reading ? <BookCover book={reading} /> : <span></span>}
    <div class="shelf-text">
      <p class="label">Reading now</p>
      {reading ? <h3>{reading.title}</h3> : <h3>Nothing on the nightstand</h3>}
      {reading && <p class="muted">{reading.author}</p>}
      <p class="shelf-stats">{read} read · {next} up next · reviews on the blog</p>
      <a class="btn" href="library.html">Open the library</a>
    </div>
  </div>
</Section>
